# Complex
comp1 = 3+2i
class(comp1)            # "complex"
Im(comp1)           # 2
Re(comp1)            # 3
Mod(comp1)            # 3.605551
Arg(comp1)            # 0.5880026
Conj(comp1)           # 3-2i
