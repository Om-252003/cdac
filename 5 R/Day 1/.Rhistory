grade <- c("A","Y","B","G","E")  ; grade
class(grade)                         # "character"
grade <- as.factor(grade)  ; grade   # Levels: A B E G Y
class(grade)                # "factor"
is.factor(grade)             # TRUE
# non-character values are coerced to character type even if single element is character
