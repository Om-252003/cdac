      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1qyvcbj0mol7z2155ty9012slnl0].[pcto:sum:Calculation_0748242207350785:qk]&quot;' value='% of Grand Total' />
        </aliases>
      </column>
      <column caption='First order date' datatype='date' name='[Calculation_0111899885023232]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Customer Name]:MIN([Order Date])}' />
      </column>
      <column caption='new or existing' datatype='string' name='[Calculation_0111899885948929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Calculation_0111899885023232]=[Order Date], &quot;New&quot;,&quot;Existing&quot;)' />
      </column>
      <column caption='Average custs' datatype='real' name='[Calculation_0111899891216386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    { INCLUDE [Region] : COUNTD([Customer Name]) }&#13;&#10;)' />
      </column>
      <column caption='Dim Formula' datatype='string' name='[Calculation_0111899897475075]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 1]=&quot;1&quot;, [Segment], IIF([Parameters].[Parameter 1]=&quot;2&quot;, [Category], [Sub-Category]))' />
      </column>
      <column caption='Date formula' datatype='boolean' name='[Calculation_0111899900608517]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Order Date]&gt;=[Parameters].[Parameter 2] and [Order Date]&lt;=[Parameters].[Start Date (copy)_0111899900141572]' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_0748242207350785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit] / [Sales] * 100' />
      </column>
      <column caption='icons' datatype='integer' name='[Calculation_0748242210738183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_0748242207350785]&gt;=.7, 1, IIF([Calculation_0748242207350785]&gt;=.4, 2, IIF([Calculation_0748242207350785]&gt;0, 3, 0)))' />
      </column>
      <column datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[Customer Name]' role='dimension' type='nominal' />
      <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
      <column caption='Profit (copy)' datatype='real' name='[Profit (copy)_0748242200469504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit]' />
      </column>
      <column datatype='integer' name='[Row ID]' role='dimension' type='ordinal' />
