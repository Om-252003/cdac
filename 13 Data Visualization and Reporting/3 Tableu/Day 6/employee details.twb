          </bin>
          <bin default-name='false' value='&quot;Retail Branch&quot;'>
            <value>&quot;Baroda&quot;</value>
            <value>&quot;Darjeeling&quot;</value>
            <value>&quot;Jaipur&quot;</value>
            <value>&quot;Lucknow&quot;</value>
            <value>&quot;Nasik&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[Branch]' role='dimension' type='nominal' />
      <column caption='Calculation1' datatype='integer' name='[Calculation_0678147309314049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Salary]' />
      </column>
      <column caption='Salary Groups' datatype='string' name='[Calculation_0678147309527042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Salary]&gt;15000, &quot;Above 25K&quot;, IIF([Salary]&gt;10000 and [Salary]&lt;15000,&quot;10k to 15K&quot;, &quot;Below 10K&quot;))' />
      </column>
      <column caption='Revised Salary' datatype='real' name='[Calculation_0678147318214659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Salary]+[Parameters].[HRA Parameter]*[Salary]' />
      </column>
      <column caption='Top Bottom N salaries' datatype='boolean' name='[Calculation_0678147324248069]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF ([Parameters].[Salary Parameter 2] = &quot;Top&quot; ,&#13;&#10;    RANK_DENSE(SUM([Salary]), &apos;desc&apos;) &lt;= [Parameters].[Salary (copy) Parameter],&#13;&#10;&#13;&#10;    RANK_DENSE(SUM([Salary]), &apos;asc&apos;) &lt;= [Parameters].[Salary (copy) Parameter])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='emp name' datatype='string' name='[Calculation_1265286445051904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[First Name]+&quot; &quot;+[Last Name]' />
      </column>
      <column caption='Top N' datatype='integer' name='[Calculation_1265286446362625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(SUM([Salary]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Bottom N' datatype='integer' name='[Calculation_1265286450315266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(SUM([Salary]), &apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='HRA' datatype='real' name='[Calculation_1265286485311491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Dept]=&quot;Mktg&quot; or [Dept]=&apos;Sales&apos; or [Dept]=&apos;Finance&apos;, .5, .3)*[Salary]' />
      </column>
      <column caption='Gross' datatype='real' name='[Calculation_1265286486249476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Salary]+[DA]+[Calculation_1265286485311491]' />
      </column>
      <column caption='Tax' datatype='real' name='[Calculation_1265286486843398]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_1265286486249476]&gt;=15000, .15, IIF([Calculation_1265286486249476]&gt;=10000, .1, IIF([Calculation_1265286486249476]&gt;5000, .05, 0)))' />
      </column>
      <column caption='Net' datatype='real' name='[Calculation_1265286489026567]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1265286486249476]-([Calculation_1265286486843398]*[Salary])' />
      </column>
