      <column datatype='string' name='[Branch (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Branch]' default='&quot;Sales Branch&quot;' new-bin='true'>
          <bin default-name='false' value='&quot;Corporate Branch&quot;'>
            <value>&quot;Banglore&quot;</value>
            <value>&quot;Calcutta&quot;</value>
            <value>&quot;chennai&quot;</value>
            <value>&quot;Delhi&quot;</value>
            <value>&quot;Hydrabad&quot;</value>
